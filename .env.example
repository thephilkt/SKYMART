# Public values from Supabase Dashboard > Connect.
# The publishable key is designed for browser use and is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never prefix service-role or database credentials with NEXT_PUBLIC_.
# Add server-only secrets only when a trusted backend flow requires them.
SUPABASE_SERVICE_ROLE_KEY=
